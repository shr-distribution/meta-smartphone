#!/bin/sh

[ ! -e /dev/pts ] && mkdir -p /dev/pts
[ ! -e /dev/pts/0 ] && mount devpts /dev/pts -t devpts

# This sets up the USB with whatever USB_FUNCTIONS are set to via configfs
USB_FUNCTIONS=$1

# Prefer the Android properties when running on top of an Android/Halium base
if [ -f /system/build.prop ]; then
    manufacturer="$(grep -o '^ro\.product\.manufacturer=.*' /system/build.prop | head -n 1 | cut -d'=' -f 2)"
    model="$(grep -o '^ro\.product\.model=.*' /system/build.prop | head -n 1 | cut -d'=' -f 2)"
fi

# Fall back to the LuneOS device properties, otherwise mainline devices end up
# with empty string descriptors and hosts show the usb.ids name for the product
# id instead
[ -z "$manufacturer" ] && manufacturer="LuneOS"
if [ -z "$model" ]; then
    model="$(cat /etc/prefs/properties/deviceName 2>/dev/null)"
    machine="$(cat /etc/prefs/properties/machineName 2>/dev/null)"
    case "$model" in
        ""|"LuneOS Device") [ -n "$machine" ] && model="LuneOS $machine" ;;
    esac
    [ -z "$model" ] && model="LuneOS Device"
fi

# get the device serial number from /proc/cmdline directly(since we have no getprop on
# GNU/Linux); fall back to the machine id on devices without androidboot.serialno
case "$(cat /proc/cmdline)" in
    *androidboot.serialno=*)
        serial="$(cat /proc/cmdline | sed 's/.*androidboot.serialno=//' | sed 's/ .*//')"
        ;;
    *)
        serial="$(cut -c 1-16 /etc/machine-id 2>/dev/null)"
        ;;
esac
[ -z "$serial" ] && serial="0123456789ABCDEF"

# Google's generic Nexus/Pixel product ids for the exposed function set, so
# hosts that only look at usb.ids no longer show "Nexus 4 (fastboot)" (d001)
idVendor="0x18D1"
if echo $USB_FUNCTIONS | grep -q "rndis"; then
    if echo $USB_FUNCTIONS | grep -q "adb"; then
        idProduct="0x4EE4" # tether + debug
    else
        idProduct="0x4EE3" # tether
    fi
else
    idProduct="0x4EE7" # charging + debug
fi

write() {
    echo " === Writing $2 into $1"
	echo -n "$2" >"$1"
}

# $1: IP address of usb interface
setup_usb_network() {
	# Run all usb network setup functions (add more below!)
	setup_usb_network_configfs
}

usb_setup_configfs() {
    GADGET_ROOT=$1
    GADGET_DIR=$GADGET_ROOT/usb_gadget
    
    mkdir -p $GADGET_ROOT
    mount -t configfs none $GADGET_ROOT || true

    mkdir $GADGET_DIR/g1
    write $GADGET_DIR/g1/idVendor                   "$idVendor"
    write $GADGET_DIR/g1/idProduct                  "$idProduct"
    mkdir $GADGET_DIR/g1/strings/0x409
    write $GADGET_DIR/g1/strings/0x409/serialnumber "$serial"
    write $GADGET_DIR/g1/strings/0x409/manufacturer "$manufacturer"
    write $GADGET_DIR/g1/strings/0x409/product      "$model"

    if echo $USB_FUNCTIONS | grep -q "rndis"; then
        mkdir $GADGET_DIR/g1/functions/rndis.usb0
    fi
    echo $USB_FUNCTIONS | grep -q "mass_storage" && mkdir $GADGET_DIR/g1/functions/storage.0
    echo $USB_FUNCTIONS | grep -q "adb" && mkdir $GADGET_DIR/g1/functions/ffs.adb

    mkdir $GADGET_DIR/g1/configs/c.1
    mkdir $GADGET_DIR/g1/configs/c.1/strings/0x409
    write $GADGET_DIR/g1/configs/c.1/strings/0x409/configuration "$USB_FUNCTIONS"

    if echo $USB_FUNCTIONS | grep -q "rndis"; then
        ln -s $GADGET_DIR/g1/functions/rndis.usb0 $GADGET_DIR/g1/configs/c.1
    fi
    echo $USB_FUNCTIONS | grep -q "mass_storage" && ln -s $GADGET_DIR/g1/functions/storage.0 $GADGET_DIR/g1/configs/c.1
    echo $USB_FUNCTIONS | grep -q "adb" && ln -s $GADGET_DIR/g1/functions/ffs.adb $GADGET_DIR/g1/configs/c.1

    # Bind now ONLY if adb is not in the mix. A FunctionFS function has no
    # descriptors until its filesystem is mounted and adbd has written them to
    # ep0, and both of those happen after this function returns - so binding
    # here with ffs.adb linked into the config fails with ENODEV and takes the
    # whole gadget down, rndis included. The bind for adb configurations is
    # done at the end of this script instead, after the mount.
    if echo $USB_FUNCTIONS | grep -q "rndis" && ! echo $USB_FUNCTIONS | grep -q "adb"; then
        write $GADGET_DIR/g1/UDC "$(first_real_udc)"
        
        # Setup usb IP address
        IP=172.16.42.2/16
        for INTERFACE in usb0 rndis0 eth0; do
            # try to setup interface. If it fails, try the next one.
            ip address add "$IP" dev $INTERFACE || continue
            # It succeeded, now bring it up and exit
            ip link set $INTERFACE up
            break
        done
    fi
}

# Pick a UDC the gadget can actually bind to.
#
# "$(ls /sys/class/udc)" assumes exactly one controller. The MP01 has two:
#
#   $ ls /sys/class/udc
#   dummy_udc.0  musb-hdrc
#
# so the write became the two names with whitespace between them, the kernel
# rejected it, the gadget never bound, and there was no adb at all - with the
# only trace being this in the journal:
#
#   android-gadget-setup: === Writing dummy_udc.0
#   musb-hdrc into /sys/kernel/config/usb_gadget/g1/UDC
#
# dummy_udc.0 is no use even when it parses: it accepts the bind and does
# nothing. Skip it and take the first real controller. Iterate the directory
# rather than parsing ls - busybox ls column-formats even into a pipe, which is
# the same trap one layer down.
first_real_udc() {
    for _u in /sys/class/udc/*; do
        [ -e "$_u" ] || continue
        _n=${_u##*/}
        case "$_n" in *dummy*) continue ;; esac
        echo "$_n"
        return 0
    done
    # Nothing but dummy: fall back to it rather than writing an empty string,
    # so the failure shows up as a dead gadget and not a confusing write error.
    for _u in /sys/class/udc/*; do
        [ -e "$_u" ] || continue
        echo "${_u##*/}"
        return 0
    done
    return 1
}

# This sets up the USB with whatever USB_FUNCTIONS are set to via android_usb
ANDROID_USB=/sys/class/android_usb/android0
usb_setup_android_usb() {
    write $ANDROID_USB/enable          0
    write $ANDROID_USB/functions       ""
    write $ANDROID_USB/enable          1
    usleep 500000 # 0.5 delay to attempt to remove rndis function
    write $ANDROID_USB/enable          0
    write $ANDROID_USB/idVendor        "${idVendor#0x}"
    write $ANDROID_USB/idProduct       "${idProduct#0x}"
    write $ANDROID_USB/iManufacturer   "$manufacturer"
    write $ANDROID_USB/iProduct        "$model"
    write $ANDROID_USB/iSerial         "$serial"
    write $ANDROID_USB/f_ffs/aliases   adb
    write $ANDROID_USB/functions       ffs
    write $ANDROID_USB/enable          1
}

# TODO enable the lines below once we have support for getprop
# retrieve the product info from Android
# manufacturer=$(getprop ro.product.manufacturer Android)
# model=$(getprop ro.product.model Android)
# serial=$(getprop ro.serialno 0123456789ABCDEF)


if [ -d $ANDROID_USB ]; then
    usb_setup_android_usb
else
    usb_setup_configfs /sys/kernel/config
fi

#below are now needed in order to use FunctionFS for ADB, tested to work with 3.4+ kernels
# FunctionFS for adb.
#
# No -o uid=/gid=. Those options need a functionfs built with uid/gid support,
# and where it is absent the mount fails outright rather than ignoring them:
#
#   mount -o uid=2000,gid=2000 -t functionfs adb /dev/usb-ffs/adb   -> rc=32
#   mount                      -t functionfs adb /dev/usb-ffs/adb   -> rc=0, ep0
#
# measured both ways on radon's 4.19 MediaTek kernel. The failure is silent in
# the worst way: with no ep0 there are no descriptors, so writing the UDC fails
# with ENODEV ("echo: write error: No such device") and the WHOLE gadget fails
# to bind - taking rndis, and with it the only network path to the device, down
# alongside adb. That is the real reason adb has never worked on this port; it
# was long blamed on function ordering, which was never the problem.
#
# adbd runs as root on LuneOS, so the ownership those options were asking for
# bought nothing. A device that genuinely needs them should set them here
# conditionally after checking the mount succeeds, not unconditionally.
#
# The /proc/filesystems guard stays, but note it only becomes true once an ffs
# instance exists - the mkdir of functions/ffs.adb above is what registers it.
if grep -q functionfs /proc/filesystems; then
    mkdir -p /dev/usb-ffs/adb
    mount -t functionfs adb /dev/usb-ffs/adb
fi

# Bind the UDC for any configuration containing adb, now that FunctionFS is
# mounted. adbd still has to open ep0 and write the descriptors before the bind
# can succeed, so give it a moment - the caller (luneos-usb-setup.sh on radon)
# starts adbd and waits for ep1 before re-binding deterministically, which is
# the reliable form. This deferred write keeps the standalone
# "android-gadget-setup adb" path working as it always did.
if echo $USB_FUNCTIONS | grep -q "adb"; then
    (usleep 1000000; write $GADGET_DIR/g1/UDC "$(first_real_udc)") &
fi

