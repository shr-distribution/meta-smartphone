#!/bin/sh
# Derive this device's configuration at runtime, so one rootfs boots anywhere.
#
# Three tiers, in order of preference (see the plan doc, section 6.6):
#
#   Tier 0  derived from the device itself - the Android properties and the
#           kernel's own view of the hardware. No per-device data at all.
#   Tier 1  /usr/share/luneos/adaptations/<codename>/deviceinfo, a small
#           declarative file for the few things that cannot be derived.
#   Tier 2  .../sparse/, a file tree overlaid onto the rootfs. Last resort;
#           every file here is a device we have not really ported yet.
#
# Nothing is ever copied into the rootfs. A universal image that has been
# rewritten to suit the first device it booted on is no longer universal, so
# adaptations are applied by overlay or bind mount and re-derived every boot.

set -u

ADAPT_ROOT=/usr/share/luneos/adaptations
RUN=/run/luneos-device
GETPROP=/android/system/bin/getprop

log() { echo "luneos-device-config: $*"; }
prop() { [ -x "$GETPROP" ] && "$GETPROP" "$1" 2>/dev/null || echo ""; }

# Resolve an input device by the name the kernel gives it.
#
# Node numbers are not stable across boots and must never be declared. On sargo
# the fingerprint HAL registers uinput-fpc as a virtual input device on some
# boots and not others, and everything enumerated after it shifts by one - the
# headset jack has been seen at event5 and at event3 on the same phone. A pin of
# /dev/input/event2 is therefore a bet on enumeration order, and when it loses
# it silently points at a different device rather than failing.
#
# The kernel's name for the device is a fact about the hardware, so declare
# that instead: deviceinfo_key_devices_by_name="qpnp_pon;gpio-keys".
resolve_input_by_name() {
    _want=$1
    for _d in /sys/class/input/event*; do
        [ -r "$_d/device/name" ] || continue
        [ "$(cat "$_d/device/name" 2>/dev/null)" = "$_want" ] || continue
        echo "/dev/input/$(basename "$_d")"
        return 0
    done
    return 1
}

# A ';' separated list of names to the ';' terminated list of nodes nyx wants.
# A name that resolves to nothing is dropped with a warning rather than failing
# the boot: the remaining keys are more useful than none.
resolve_input_list_by_name() {
    _rest=$1
    _out=
    while [ -n "$_rest" ]; do
        _name=${_rest%%;*}
        case "$_rest" in *\;*) _rest=${_rest#*;} ;; *) _rest= ;; esac
        [ -n "$_name" ] || continue
        if _node=$(resolve_input_by_name "$_name"); then
            _out="${_out}${_node};"
        else
            # stderr: this function's stdout is its return value, and a warning
            # printed there would be captured into the list.
            log "WARNING: no input device named '$_name'" >&2
        fi
    done
    echo "$_out"
}

mkdir -p "$RUN"

# ---------------------------------------------------------------- Tier 0 ----

# Codename. The vendor's own idea of the device is the one that matters: on a
# GSI, ro.product.device is the GSI's (halium_arm64), not the phone's.
codename=$(prop ro.product.vendor.device)
[ -n "$codename" ] || codename=$(prop ro.vendor.product.device)
[ -n "$codename" ] || codename=$(prop ro.product.device)
[ -n "$codename" ] || codename=unknown

# Vendor API level: which GSI generation this vendor expects to talk to.
api_level=$(prop ro.board.api_level)
[ -n "$api_level" ] || api_level=$(prop ro.vndk.version)
[ -n "$api_level" ] || api_level=$(prop ro.build.version.sdk)

density=$(prop ro.sf.lcd_density)

# Panel geometry from DRM. There is no fbdev on a modern Halium device - sargo
# has no /sys/class/graphics/fb0 at all - and the virtual connector reports a
# nonsense 4096x2160, so take the first mode of a genuinely connected one.
panel_w= panel_h=
for c in /sys/class/drm/card*-*/status; do
    [ -e "$c" ] || continue
    [ "$(cat "$c" 2>/dev/null)" = "connected" ] || continue
    case "$c" in */card*-Virtual-*) continue ;; esac
    mode=$(head -n1 "${c%/status}/modes" 2>/dev/null)
    case "$mode" in
        [0-9]*x[0-9]*) panel_w=${mode%%x*}; panel_h=${mode##*x}; break ;;
    esac
done

# Touchscreen. Exactly one input device advertises ID_INPUT_TOUCHSCREEN, so
# this needs no per-device knowledge.
touchscreen=
for d in /sys/class/input/event*; do
    [ -e "$d" ] || continue
    n=$(basename "$d")
    if udevadm info --query=property --name="/dev/input/$n" 2>/dev/null |
           grep -q '^ID_INPUT_TOUCHSCREEN=1$'; then
        touchscreen="/dev/input/$n"
        break
    fi
done

# Key devices. Derivation only narrows this to a superset: on sargo the power
# key (qpnp_pon) and the fingerprint sensor (uinput-fpc) are both virtual
# devices advertising KEY_POWER, so neither the virtual/physical split nor the
# capability bits separate them. Tier 1 can override; otherwise take everything
# that claims power or volume and let the consumer ignore the rest.
keydevs=
for d in /sys/class/input/event*; do
    [ -e "$d" ] || continue
    n=$(basename "$d")
    props=$(udevadm info --query=property --name="/dev/input/$n" 2>/dev/null)
    echo "$props" | grep -q '^ID_INPUT_KEY=1$' || continue
    echo "$props" | grep -q '^ID_INPUT_TOUCHSCREEN=1$' && continue
    keydevs="${keydevs}/dev/input/$n;"
done

# ---------------------------------------------------------------- Tier 1 ----

adaptation="$ADAPT_ROOT/$codename"
if [ -f "$adaptation/deviceinfo" ]; then
    log "using adaptation $codename"
    # shellcheck disable=SC1090
    . "$adaptation/deviceinfo"
    # Names first: a name survives a change in enumeration order, a node number
    # does not. The *_device / *_devices forms stay for adaptations not yet
    # converted, but nothing new should use them.
    if [ -n "${deviceinfo_touchscreen_by_name:-}" ]; then
        if _t=$(resolve_input_by_name "$deviceinfo_touchscreen_by_name"); then
            touchscreen=$_t
        else
            log "WARNING: no input device named '$deviceinfo_touchscreen_by_name', keeping derived $touchscreen"
        fi
    elif [ -n "${deviceinfo_touchscreen_device:-}" ]; then
        touchscreen=$deviceinfo_touchscreen_device
    fi

    if [ -n "${deviceinfo_key_devices_by_name:-}" ]; then
        _k=$(resolve_input_list_by_name "$deviceinfo_key_devices_by_name")
        if [ -n "$_k" ]; then
            keydevs=$_k
        else
            log "WARNING: none of '$deviceinfo_key_devices_by_name' resolved, keeping derived $keydevs"
        fi
    elif [ -n "${deviceinfo_key_devices:-}" ]; then
        keydevs=$deviceinfo_key_devices
    fi

    [ -n "${deviceinfo_display_density:-}" ] && density=$deviceinfo_display_density
else
    log "no adaptation for '$codename', running on derived values alone"
fi

cat > "$RUN/device.env" <<EOF
LUNEOS_DEVICE_CODENAME=$codename
LUNEOS_VENDOR_API_LEVEL=$api_level
LUNEOS_DISPLAY_DENSITY=$density
LUNEOS_PANEL_WIDTH=$panel_w
LUNEOS_PANEL_HEIGHT=$panel_h
LUNEOS_TOUCHSCREEN_DEVICE=$touchscreen
LUNEOS_KEY_DEVICES=$keydevs
EOF
log "codename=$codename api=$api_level density=$density panel=${panel_w}x${panel_h} touch=$touchscreen keys=$keydevs"

# ------------------------------------------------------- generators ----
# Each concern is a small script under generators/, run in name order with the
# derived values in the environment. A generator writes files and never mounts
# anything; this script does all the mounting, so the contract is one-way and a
# generator can be added, dropped or upstreamed on its own.
#
#   $GEN/files/<absolute target path>   shadow an existing rootfs file
#   $GEN/configd/<name>.json            a configd override layer entry
#
# Everything lands under /run: the rootfs is never written to, or a universal
# image would stop being universal after its first boot.

GEN=$RUN/gen
GENERATORS=/usr/lib/luneos-device-config/generators

rm -rf "$GEN"; mkdir -p "$GEN/files" "$GEN/configd"

export GEN ADAPT_ROOT RUN
export codename api_level density touchscreen keydevs adaptation panel_w panel_h
# Tier 1 values too, so a generator can prefer a declared value over a derived one.
for v in $(set | sed -n 's/^\(deviceinfo_[A-Za-z0-9_]*\)=.*/\1/p'); do
    export "$v"
done

if [ -d "$GENERATORS" ]; then
    for g in "$GENERATORS"/*; do
        [ -x "$g" ] || continue
        "$g" || log "WARNING: generator $(basename "$g") failed"
    done
fi

# Shadow generated files over their targets. A target that does not exist is
# skipped rather than created: creating it would mean writing to the rootfs.
find "$GEN/files" -type f 2>/dev/null | while read -r f; do
    target=${f#"$GEN/files"}
    if [ ! -e "$target" ]; then
        log "skipping $target (nothing to shadow)"
        continue
    fi
    mountpoint -q "$target" 2>/dev/null && continue
    if mount --bind "$f" "$target"; then
        log "generated $target"
    else
        log "WARNING: could not bind $target"
    fi
done

# configd is a layered store: /etc/configd/layers.json already declares an
# "Override configs" layer at priority 900 for exactly this. Feeding it beats
# rewriting the OWO/OSE config files, which are upstream-owned, and it is the
# same shape as Sailfish's dconf vendor.d overrides.
#
# configd caches its merged view and will not notice a new layer until the
# cache is gone - adding the layer and restarting configd alone changes
# nothing. The layer directory itself is shipped by this package so that
# mounting onto it does not modify the rootfs either.
if [ -n "$(ls -A "$GEN/configd" 2>/dev/null)" ] && [ -d /etc/configd/layers/overlay ]; then
    if mountpoint -q /etc/configd/layers/overlay 2>/dev/null; then
        log "configd overlay layer already mounted"
    elif mount --bind "$GEN/configd" /etc/configd/layers/overlay; then
        log "bound generated configd layer"
        rm -f /var/preferences/configd_db.json /var/preferences/configd_debug_db.json
    else
        log "WARNING: could not bind configd overlay layer"
    fi
fi

# ---------------------------------------------------------------- Tier 2 ----
# Apply the file tree. overlayfs in one mount where the kernel has it, else a
# bind mount per file - equally non-destructive, just noisier.
apply_sparse() {
    sparse="$adaptation/sparse"
    [ -d "$sparse" ] || return 0
    if grep -qw overlay /proc/filesystems 2>/dev/null; then
        for sub in etc usr/lib/luneos/device; do
            [ -d "$sparse/$sub" ] || continue
            mkdir -p "$RUN/work/$sub" "$RUN/upper/$sub"
            if mount -t overlay overlay \
                 -o "lowerdir=$sparse/$sub:/$sub,upperdir=$RUN/upper/$sub,workdir=$RUN/work/$sub" \
                 "/$sub" 2>/dev/null; then
                log "overlaid $sparse/$sub onto /$sub"
                continue
            fi
            log "overlay of /$sub failed, falling back to bind mounts"
            bind_tree "$sparse/$sub" "/$sub"
        done
    else
        log "kernel has no overlayfs, using bind mounts"
        bind_tree "$sparse" ""
    fi
}

bind_tree() {
    src=$1; prefix=$2
    find "$src" -type f 2>/dev/null | while read -r f; do
        rel=${f#"$src"}
        target="$prefix$rel"
        [ -e "$target" ] || { log "skipping $target (no such file to shadow)"; continue; }
        mount --bind "$f" "$target" && log "bound $target"
    done
}

apply_sparse
exit 0
