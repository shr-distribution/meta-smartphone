#!/bin/sh
# ofono's RIL topology, from what the vendor's RIL actually advertises.
#
# ofono-binder-plugin enumerates slots from the HAL, not from binder.conf, so a
# slot present on the device but missing from the file is not "single SIM" - it
# is a missing entry, and ofonod aborts at startup with "Missing path for slot
# slotN" and is restarted forever. sargo hit exactly this: its vendor RIL is a
# multi-SIM build, init starts qcrild and qcrild2, and both register, so the HAL
# advertises IRadio/slot1 and /slot2 while binder.conf declared only slot1.
#
# Deriving it from the HAL cannot disagree with the HAL, which is the point.

LSHAL=
for c in lshal /android/system/bin/lshal /system/bin/lshal; do
    command -v "$c" >/dev/null 2>&1 && { LSHAL=$c; break; }
done
[ -n "$LSHAL" ] || exit 0

slots=$($LSHAL 2>/dev/null |
        grep -oE 'android\.hardware\.radio@[0-9.]+::IRadio/slot[0-9]+' |
        sed 's|.*/||' | sort -u)
[ -n "$slots" ] || exit 0

mkdir -p "$GEN/files/etc/ofono"

# ExpectSlots names only the first: boot should not wait on slots that are
# empty unless a SIM or eUICC profile is present.
{
    echo "# Generated by luneos-device-config from the RIL HAL's advertised slots."
    echo "[Settings]"
    echo "ExpectSlots = slot1"
    for s in $slots; do
        n=${s#slot}
        echo
        echo "[$s]"
        echo "path = /ril_$((n - 1))"
        echo "slot = $((n - 1))"
    done
} > "$GEN/files/etc/ofono/binder.conf"

{
    echo "# Generated by luneos-device-config from the RIL HAL's advertised slots."
    echo "[Settings]"
    echo "allowDataReq=on"
    for s in $slots; do
        n=${s#slot}
        echo
        echo "[ril_$((n - 1))]"
        echo "transport=binder:name=$s"
        echo "name=$s"
    done
} > "$GEN/files/etc/ofono/ril_subscription.conf"

echo "luneos-device-config: ofono slots derived: $(echo $slots | tr '\n' ' ')"
