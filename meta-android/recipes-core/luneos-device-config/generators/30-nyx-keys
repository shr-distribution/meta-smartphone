#!/bin/sh
# nyx's key input devices.
#
# Derivation narrows these to a superset - everything claiming KEY_POWER or a
# volume key that is not the touchscreen - which on sargo also catches the
# fingerprint sensor and the headset button jack. Neither the virtual/physical
# split nor the capability bits separate them, since qpnp_pon (the power key)
# and uinput-fpc are both virtual and both claim power. So a device that cares
# pins the list in deviceinfo, and the derived superset is the fallback for a
# device with no adaptation at all.
SRC=/etc/nyx.conf
[ -f "$SRC" ] || SRC=/etc/nyx/nyx.conf
[ -f "$SRC" ] || exit 0
[ -n "${keydevs:-}" ] || exit 0

if ! grep -q "^paths=" "$SRC"; then
    echo "luneos-device-config: WARNING: no paths= anchor in $SRC; cannot set this value"
    exit 0
fi
grep -q "^paths=$keydevs\$" "$SRC" && exit 0   # already correct

target=${SRC#/}
mkdir -p "$GEN/files/$(dirname "$target")"
sed "s|^paths=.*|paths=$keydevs|" "$SRC" > "$GEN/files/$target"
echo "luneos-device-config: nyx key devices -> $keydevs"
