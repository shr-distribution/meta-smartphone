# Tier 1 adaptation for the Google Pixel 3a (sargo).
#
# Only what cannot be derived belongs here. Everything absent from this file is
# worked out at runtime - the codename itself, the vendor API level, the display
# density and the touchscreen node all derive correctly on this device.
#
# Key devices are the exception. Derivation narrows them to everything claiming
# KEY_POWER or a volume key that is not the touchscreen, which on sargo catches
# the power key and the volume rocker but also the fingerprint sensor
# (uinput-fpc) and the headset button jack. The obvious discriminators do not
# separate them: qpnp_pon and uinput-fpc are both virtual devices and both
# advertise power/volume in their capability bits. So pin the two the device
# shipped with.
#
# Pinned by name, never by node number. Numbering is not stable here: uinput-fpc
# only exists on boots where the fingerprint HAL registers it, and everything
# enumerated after it shifts - the headset jack has been observed at event5 and
# at event3 on this same phone. A node pin that loses that race does not fail,
# it quietly selects a different device.
#
# The headset jack's volume keys may well be worth having; that is a behaviour
# change to test deliberately, not to acquire by accident.
deviceinfo_key_devices_by_name="qpnp_pon;gpio-keys"

# Tuned by eye, not derived. webOS apps are fixed-layout Enyo pages, so the
# ratio decides how many CSS pixels they get: 1080/2.4 = 450, which is what
# they are built for. The "natural" density/160 of 2.75 gives 393 and they
# inflate and clip - verified on device.
deviceinfo_device_pixel_ratio="2.4"

# The panel's true physical PPI. Not derivable: it needs the panel's physical
# dimensions, which an internal DSI panel does not report, and Android's
# density bucket (440) is close but not the same number. sargo shipped 441.
deviceinfo_display_dpi="441"
