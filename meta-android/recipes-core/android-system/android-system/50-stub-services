#!/bin/sh

# Some Android services are useless under Halium (no Android frameworks) and
# only fill the journal: they poll for framework services that never exist
# here, or crash-loop outright. The list is one container-relative binary path
# per line, optionally followed by "exit" to make the stub exit 0 (for helpers
# init runs with exec_start and waits on) instead of sleeping forever. A stub
# is bind-mounted over each binary, so the service still "runs" as far as init
# is concerned but does no work. Bind mounts also work on a read-only image,
# unlike the init.rc patching hooks.
#
# Which list to use is a property of the phone, not of the build. A device that
# builds no rootfs of its own - sargo, surya, bluejay, panther all run the
# generic halium-arm64 image - cannot have a machine layer install a single
# stubbed-services file for it, so the lists ship together under
# stubbed-services.d/ and this picks the one matching the device.
#
# The codename cannot come from getprop: this runs before the container starts,
# so there is no property service yet. It comes from the vendor build.prop
# instead, which is the *phone's* own idea of what it is - on a GSI
# ro.product.device is the GSI's (halium_arm64), which is why the vendor
# properties are preferred here in the same order luneos-device-config uses.

DIR=/var/lib/lxc/android/stubbed-services.d
LIST=/var/lib/lxc/android/stubbed-services

prop() {
    for f in "$LXC_ROOTFS_PATH/vendor/build.prop" /vendor/build.prop \
             "$LXC_ROOTFS_PATH/system/build.prop"; do
        [ -r "$f" ] || continue
        v=$(sed -n "s/^$1=//p" "$f" 2>/dev/null | head -n1)
        [ -n "$v" ] && { echo "$v"; return 0; }
    done
    return 1
}

codename=$(prop ro.product.vendor.device) \
    || codename=$(prop ro.vendor.product.device) \
    || codename=$(prop ro.product.device) \
    || codename=

# Fall back to the device tree the same way luneos-device-config does, so a
# port with no usable vendor build.prop can still be matched.
if [ -z "$codename" ] && [ -r /proc/device-tree/compatible ]; then
    _compat=$(tr '\0' '\n' < /proc/device-tree/compatible 2>/dev/null | head -n1)
    case "$_compat" in *,*) codename=${_compat#*,} ;; esac
fi

# A per-codename list wins; the single-file path stays as the fallback so a
# machine that still builds its own rootfs can keep installing one directly.
if [ -n "$codename" ] && [ -r "$DIR/$codename" ]; then
    LIST="$DIR/$codename"
    echo "$(basename "$0"): using stub list for '$codename'"
fi

[ -r "$LIST" ] || exit 0

while read -r path mode; do
    case "$path" in
        ''|\#*) continue ;;
    esac
    target="$LXC_ROOTFS_PATH/$path"
    if [ ! -e "$target" ]; then
        echo "$(basename "$0"): $path not present, skipping"
        continue
    fi
    case "$mode" in
        exit) stub=/var/lib/lxc/android/stubs/stub-exit ;;
        *)    stub=/var/lib/lxc/android/stubs/stub-sleep ;;
    esac
    if mount --bind "$stub" "$target"; then
        echo "$(basename "$0"): stubbed $path"
    else
        echo "$(basename "$0"): failed to stub $path"
    fi
done < "$LIST"
