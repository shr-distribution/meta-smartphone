[Unit]
Description=Android System Container
Before=network.target ofono.service pulseaudio.service sensorfwd.service
# The compositor must not start until the Android side is up. libhybris prefers
# the HIDL composer HAL over hwbinder, but silently falls back to dlopen'ing the
# hwcomposer module in-process if that service is not registered yet - and the
# fallback opens /dev/dri/card0 directly, creating a second HWCSession that
# fights the composer service for DRM master. The compositor's render thread
# then waits forever on fences delivered to the other process: input keeps
# arriving, no frames are produced, and the UI is unusable at 0% CPU.
Before=surface-manager-daemon.service

[Service]
Type=simple
# Map and mount the device's own Android partitions (super/dynamic partitions,
# vendor, vendor_dlkm, odm, and whatever the vendor's fstab asks for) before the
# container's init can look for them.
ExecStartPre=/usr/bin/mount-android.sh
ExecStart=/usr/bin/lxc-start -n android -l DEBUG -- /init
ExecStartPost=/usr/bin/start-android-hals.sh
ExecStartPost=/usr/bin/wait-for-android.sh
ExecStop=/usr/bin/lxc-stop -n android -t 5
RemainAfterExit=yes
# Never kill the android system when we're on low memory
OOMScoreAdjust=-1000

[Install]
RequiredBy=basic.target
