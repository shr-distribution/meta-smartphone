lxc.rootfs.path = /var/lib/lxc/android/rootfs
lxc.uts.name = android

lxc.tty.dir = lxc
lxc.tty.max  = 4
lxc.pty.max = 1024
lxc.arch = @LXC_ARCH@
lxc.cap.drop = mac_admin mac_override

lxc.hook.pre-start = /var/lib/lxc/android/pre-start.sh
lxc.hook.post-stop = /var/lib/lxc/android/post-stop.sh

# We have to share the network namespace with the host as otherwise the RIL
# service doesn't have access to the network interfaces it needs to setup
# a data connection.
lxc.net.0.type = none

lxc.init.cmd = /init

lxc.apparmor.profile = unconfined
lxc.autodev = 0

lxc.mount.entry = tmpfs dev tmpfs nosuid 0 0
lxc.mount.entry = /dev/__properties__ dev/__properties__ bind bind,create=dir 0 0
# binderfs replaces the static /dev/binder* nodes from Android 11 / kernel 5.x.
# Marked optional so this config stays valid on older kernels without
# CONFIG_ANDROID_BINDERFS, where mount-android.sh will not have created it.
lxc.mount.entry = /dev/binderfs dev/binderfs bind bind,create=dir,optional 0 0
lxc.mount.entry = /dev/socket dev/socket bind bind,create=dir 0 0
lxc.mount.entry = proc proc proc nodev,noexec,nosuid 0 0
lxc.mount.entry = sysfs sys sysfs nodev,noexec,nosuid 0 0
#lxc.mount.entry = tmpfs tmp tmpfs nodev,noexec,nosuid 0 0
lxc.mount.entry = /android/data data bind bind 0 0
lxc.mount.entry = /mnt mnt bind rbind 0 0
# rbind, so the individual APEX mounts inside /apex come along - a plain bind
# would give the container an empty tmpfs. optional, because Android 9 images
# have no APEX at all and there is nothing to bind.
#
# This has to be a bind from outside the rootfs: mounting the APEXes directly
# under /android does not survive, because /android is the rootfs LXC sets up
# and it drops anything already mounted there.
lxc.mount.entry = /apex apex bind rbind,optional 0 0
# Same story as /apex: mounted on the host and bound in, because anything put
# under /android is inside the rootfs LXC re-establishes. optional, since only
# Android 10/11+ devices have them.
lxc.mount.entry = /odm odm bind bind,optional 0 0
lxc.mount.entry = /vendor_dlkm vendor_dlkm bind bind,optional 0 0
