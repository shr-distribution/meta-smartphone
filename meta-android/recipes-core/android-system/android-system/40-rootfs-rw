#!/bin/sh

# init.rc is inside the Android image, which is read-only for a GSI. pre-start.sh
# works out which case we are in; skip cleanly rather than failing at sed.
if [ "${LXC_ROOTFS_WRITABLE:-0}" != "1" ]; then
    echo "$(basename "$0"): Android rootfs read-only, skipping"
    exit 0
fi

# We're on the same partition so don't mount it as read-only
sed -i "/mount rootfs rootfs \/ ro remount/d" $LXC_ROOTFS_PATH/init.rc
