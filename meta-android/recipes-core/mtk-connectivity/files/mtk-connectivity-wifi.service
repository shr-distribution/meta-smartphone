[Unit]
Description=Power on MediaTek combo Wi-Fi
After=mtk-connectivity-modules.service
Requires=mtk-connectivity-modules.service
Conflicts=shutdown.target actdead.target

# Same hardware test mtk-connectivity-modules.service uses, because Requires=
# on a unit that condition-skipped does not hold this one back: a failed
# condition is "skip", not "fail", so the dependency is satisfied and this ran
# anyway on every Halium machine. COMPATIBLE_MACHINE is ^halium$, so that is
# every port, MediaTek or not.
#
# On a Qualcomm device none of the markers below exist and there is nothing to
# power on - wlan0 comes from the Qualcomm driver - so the ExecStart loop just
# polls until wlan0 appears and exits. Measured: 37ms on sargo, where wlan0 was
# already up, and 10.1s on tissot, where it was not.
ConditionPathExists=|/android/vendor/lib/modules/wmt_drv.ko
ConditionPathExists=|/android/vendor/lib/modules/conninfra.ko
ConditionPathExists=|/dev/wmtWifi

[Service]
Type=oneshot
RemainAfterExit=yes
# The write only takes once the container's wmt/connac daemons have patched the
# CONSYS firmware, so retry until wlan0 appears. /dev/wmtWifi is the WMT-era
# power switch; on connac the module bring-up already yields wlan0, in which
# case the first loop iteration exits immediately.
ExecStart=/bin/sh -c 'i=0; while [ $i -lt 90 ]; do ip link show wlan0 >/dev/null 2>&1 && exit 0; [ -e /dev/wmtWifi ] && echo 1 > /dev/wmtWifi 2>/dev/null; sleep 2; i=$((i+1)); done; exit 1'

[Install]
WantedBy=multi-user.target
