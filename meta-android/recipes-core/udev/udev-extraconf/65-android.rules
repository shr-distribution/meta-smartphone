# logging devices
ACTION=="add", KERNEL=="log_*", MODE="0666"
ACTION=="add", KERNEL=="log_main", SYMLINK+="alog/main"
ACTION=="add", KERNEL=="log_system", SYMLINK+="alog/system"
ACTION=="add", KERNEL=="log_radio", SYMLINK+="alog/radio"
ACTION=="add", KERNEL=="log_events", SYMLINK+="alog/events"

# system devices
#
# All three binder domains, not just /dev/binder. hwbinder is how a process
# reaches the HIDL HALs, and a non-root one that cannot open it dies the moment
# it needs graphics: android::GraphicBufferMapper's constructor cannot get the
# gralloc mapper and calls LOG_ALWAYS_FATAL, so WebAppMgr - which runs as "wam" -
# aborted on every app launch:
#
#     #4 __android_log_assert (liblog.so)
#     #5 android::GraphicBufferMapper::GraphicBufferMapper() (libui.so)
#     #6 graphic_buffer_mapper_import_buffer_no_size (libui_compat_layer.so)
#     WebAppMgr dumped core, signal 6/ABRT
#
# vndbinder is the vendor domain and belongs with them. The per-device rule
# files all granted all three; only /dev/binder had made it into this generic
# file, which is why no device without one of those files could run a web app.
ACTION=="add", KERNEL=="binder", MODE="0666"
ACTION=="add", KERNEL=="hwbinder", MODE="0666"
ACTION=="add", KERNEL=="vndbinder", MODE="0666"

# graphics devices
SUBSYSTEM=="graphics", KERNEL=="*", SYMLINK+="graphics/%k"

# input devices
ACTION=="add", KERNEL=="event[0-9]*", GROUP="input", MODE="0660"

# misc devices
# AOSP ueventd grants /dev/alarm to group radio, and all seven per-machine rule
# files that set it agreed on that; the system:system here was the outlier, and
# at mode 0664 the group is what decides who may write it.
ACTION=="add", KERNEL=="alarm", OWNER="system", GROUP="radio", MODE="0664"
ACTION=="add", KERNEL=="uhid", OWNER="system", GROUP="system", MODE="0660"

# memory
ACTION=="add", KERNEL=="ashmem", OWNER="system", GROUP="system", MODE="0666"

# GPU and graphics buffer allocators.
#
# These were only ever set by the per-device rule files each vendor layer ships
# (70-sargo.rules and friends), so a machine without one - such as the generic
# halium-arm64 - left them root:root 0660 and nothing running as a non-root user
# could reach the GPU. WebAppMgr runs as "wam", so every app launch crashed in
# Android's libEGL:
#
#     #1 __GI_strstr (libc.so.6)
#     #2 android::egl_display_t::initialize() (/android/system/lib64/libEGL.so)
#     #3 eglInitialize (libEGL.so.1)
#     WebAppMgr dumped core, signal 11/SEGV
#
# - the driver failed to come up and returned a NULL extension string. 634
# crashes in one boot, each one an app relaunch, each relaunch replaying the UI
# sound. Ownership matters as much as the mode: granting 0666 while leaving the
# nodes root-owned did not help.
#
# The values match what AOSP's ueventd grants, which is what the per-device
# files were transcribing. A rule for a node the device does not have simply
# never matches, so this is safe on any Halium target.
ACTION=="add", KERNEL=="kgsl", OWNER="system", GROUP="system", MODE="0666"
ACTION=="add", KERNEL=="kgsl-3d0", OWNER="system", GROUP="system", MODE="0666"
# PowerVR's equivalent of kgsl, on MediaTek among others. Without it the node
# stays root:root 0660 and only root can get a GL context: the compositor runs
# as root and renders, while chromium's sandboxed GPU process cannot, so
# webruntime fails with "eglCreateContext ES 3.0 failed with error
# EGL_BAD_ALLOC" and treats it as fatal - no GPU process, no app rendering.
# That reads like a missing ES3 capability and is not: with this node readable
# an unprivileged process gets a full ES 3.2 context (libhybris' test_glesv3
# renders fine as nobody). The render node is enough on top of this one; the
# KMS card node can stay 0660.
ACTION=="add", KERNEL=="pvr_sync", OWNER="system", GROUP="system", MODE="0666"
ACTION=="add", KERNEL=="ion", OWNER="system", GROUP="system", MODE="0664"
ACTION=="add", SUBSYSTEM=="dma_heap", OWNER="system", GROUP="system", MODE="0664"
ACTION=="add", KERNEL=="dri/*", OWNER="root", GROUP="graphics", MODE="0666"
ACTION=="add", KERNEL=="graphics/*", OWNER="root", GROUP="graphics", MODE="0660"
ACTION=="add", KERNEL=="adsprpc-smd", OWNER="system", GROUP="system", MODE="0664"

# rfkill
ACTION=="add", KERNEL=="rfkill", GROUP="input", MODE="0660"

# ---------------------------------------------------------------------------
# The common Android device-node set, folded in from the per-machine
# 70-<machine>.rules files.
#
# Every rule below was present in at least two of those files, and every file
# that had it agreed on owner, group and mode - so it describes Android
# userspace rather than any one phone, and keeping twelve copies only made it
# possible for them to drift.
#
# It has to live here rather than in a per-machine file because a device that
# builds no rootfs of its own has no per-machine file to put it in: sargo,
# surya, bluejay and panther all run the generic halium-arm64 image. A rule for
# a node the device does not have never matches, so shipping the union costs
# the others nothing; where a machine had no opinion at all the node was
# root:root 0600, and what it gains here is the AOSP permission for it.
#
# The 39 match patterns the machines genuinely disagreed on are deliberately
# not here. They stay in the per-machine files, which udev reads after this one
# and which therefore still win.
# ---------------------------------------------------------------------------
ACTION=="add", KERNEL=="null", OWNER="root", GROUP="root", MODE="0666"
ACTION=="add", KERNEL=="zero", OWNER="root", GROUP="root", MODE="0666"
ACTION=="add", KERNEL=="full", OWNER="root", GROUP="root", MODE="0666"
ACTION=="add", KERNEL=="ptmx", OWNER="root", GROUP="root", MODE="0666"
ACTION=="add", KERNEL=="tty", OWNER="root", GROUP="root", MODE="0666"
