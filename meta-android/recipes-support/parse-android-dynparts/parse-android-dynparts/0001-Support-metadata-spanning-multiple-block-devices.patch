+namespace {
+
+// Split a hint like "/dev/disk/by-partlabel/system_a" into the directory it
+// lives in and the A/B slot suffix its name carries, so that sibling block
+// devices can be found next to it.
+void SplitDeviceHint(const std::string& path, std::string* dir,
+                     std::string* slot_suffix) {
+  const auto slash = path.rfind('/');
+  *dir = (slash == std::string::npos) ? std::string(".") : path.substr(0, slash);
+  const std::string base =
+      (slash == std::string::npos) ? path : path.substr(slash + 1);
+  if (base.size() > 2) {
+    const std::string tail = base.substr(base.size() - 2);
+    if (tail == "_a" || tail == "_b") *slot_suffix = tail;
+  }
+}
+
+}  // namespace
+
 int main(int argc, char* argv[]) {
-  if (argc != 2) {
-    cerr << "Usage: dmsetup create --concise \"$(" << argv[0] << " device)\""
+  if (argc < 2) {
+    cerr << "Usage: dmsetup create --concise \"$(" << argv[0]
+         << " device [name=path ...])\"" << endl;
+    cerr << "  device     block device holding the LP metadata. On a normal"
+         << " layout that is the" << endl;
+    cerr << "             super partition; with retrofit dynamic partitions"
+         << " it is the metadata" << endl;
+    cerr << "             device, e.g. /dev/disk/by-partlabel/system_a."
          << endl;
+    cerr << "  name=path  override for a block device named in the metadata."
+         << " Without one," << endl;
+    cerr << "             siblings are looked up beside the device above,"
+         << " keeping its slot" << endl;
+    cerr << "             suffix." << endl;
     return 1;
   }
 
+  std::string device_dir, slot_suffix;
+  SplitDeviceHint(argv[1], &device_dir, &slot_suffix);
+
+  std::map<std::string, std::string> overrides;
+  for (int i = 2; i < argc; i++) {
+    const std::string arg = argv[i];
+    const auto eq = arg.find('=');
+    if (eq == std::string::npos || eq == 0) {
+      cerr << "Malformed override \"" << arg << "\", expected name=path"
+           << endl;
+      return 1;
+    }
+    overrides[arg.substr(0, eq)] = arg.substr(eq + 1);
+  }
+
   auto metadata = ReadMetadata(argv[1], 0);
   if (!metadata) {
     cerr << "Failed to parse metadata from \"" << argv[1] << "\"" << endl;
     return 1;
   }
 
+  // Retrofit dynamic partitions spread the "super" across several pre-existing
+  // partitions instead of one dedicated device, so an extent can live on a
+  // block device other than the one the metadata was read from. Resolve each
+  // extent's source index to a path.
+  const auto device_path_for = [&](uint32_t source) -> std::string {
+    if (source == 0) return argv[1];
+    if (source >= metadata->block_devices.size()) return std::string();
+    const std::string name =
+        GetBlockDevicePartitionName(metadata->block_devices[source]);
+    const auto it = overrides.find(name);
+    if (it != overrides.end()) return it->second;
+    // Measured on a Pixel 3a running stock Android 11: the metadata names its
+    // block devices "system_a"/"vendor_a", i.e. the slot suffix is already
+    // part of the recorded name. Appending it unconditionally produced
+    // /dev/disk/by-partlabel/vendor_a_a and dmsetup failed the whole table
+    // with ENXIO. Only append what is not already there.
+    if (!slot_suffix.empty() && name.size() > slot_suffix.size() &&
+        name.compare(name.size() - slot_suffix.size(),
+                     slot_suffix.size(), slot_suffix) == 0)
+      return device_dir + "/" + name;
+    return device_dir + "/" + name + slot_suffix;
+  };
+
   std::string table;
 
   // Code structure taken from Android's system/core/fs_mgr/fs_mgr_dm_linear.cpp
@@ -53,14 +124,16 @@ int main(int argc, char* argv[]) {
           line << "," << sector << " " << extent.num_sectors << " zero";
           break;
         case LP_TARGET_TYPE_LINEAR: {
