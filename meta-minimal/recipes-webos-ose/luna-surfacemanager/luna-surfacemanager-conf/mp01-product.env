# Minimal Phone MP01 compositor environment.

# Do not open the hwcomposer HAL a second time in this process.
#
# qt6-qpa-hwcomposer-plugin's HwComposerBackend::create() normally calls
# hw_get_module()/open() to discover the HWC version, and only then hands the
# real work to libhwc2_compat_layer, which talks HIDL to the Android composer
# service. On most adaptations that extra open is harmless. On MediaTek it is
# not: opening hwcomposer.mtk_common.so constructs an HWCMediator, and that
# immediately tries to take DRM master on /dev/dri/card0 - which the composer
# service already holds. Neither side yields, and the compositor spends its
# whole 90 s start timeout logging
#
#   E hwcomposer: [DRMDEV] failed to get drm master, retry: 1054401
#
# at roughly 130 retries a second, never reaching sd_notify(READY=1).
#
# The plugin has an escape hatch for exactly this, and its comment describes
# this device: "Create hwcomposer backend directly without opening hardware
# module because on some devices loading hwc2 module twice breaks graphics
# (The first load is in the composer android service.)". Taking it leaves the
# composer service as the single DRM master and reaches the HAL over HIDL,
# which is what every other Halium HWC2 adaptation does anyway.
#
# Note this is only half of the MP01's display story: the composer service can
# only initialise DRM at all because mediatek-drm.ko is patched to create the
# standard "alpha" and "pixel blend mode" plane properties. Without that patch
# the service fails plane setup and forcing HWC2 just moves the hang.
export QT_QPA_FORCE_HWC2=1

# Rotate touch input to match. The compositor rotates its scene (see
# deviceinfo_compositor_geometry), but evdevtouch reports in the panel's own
# orientation, so without this taps land a quarter turn from what is drawn.
#
# Note this is a different axis from the gesture positions fixed in
# luna-next-cardshell's OrientationHelper: this one corrects what Qt delivers to
# items, that one corrects what GestureHandler reads straight off QScreen.
export WEBOS_COMPOSITOR_EXTRA_OPTIONS="-plugin evdevtouch:/dev/input/event3:rotate=270 -plugin evdevkeyboard:/dev/input/event0 -plugin evdevkeyboard:/dev/input/event1"
