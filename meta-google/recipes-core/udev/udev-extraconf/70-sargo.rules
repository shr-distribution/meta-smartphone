# Pixel 3a (sargo) device-node permissions that are not in 65-android.rules.
#
# What is left after the common Android set was folded into that file: nodes no
# other port has (the Titan M security chip, the Pixel Visual Core, the NXP
# secure element) and the handful where sargo's ueventd disagrees with every
# other machine - notably uinput, which bluetooth HID needs, and the IPA data
# path nodes, which mobile data needs.
#
# Shipped by the *generic* rootfs, not by a sargo rootfs: sargo builds only a
# boot image (see sargo.conf), so there is no per-machine image to carry this.
# udev rules have to exist before the coldplug, which rules out the runtime
# Tier 2 adaptation path in luneos-device-config - that service is ordered
# after systemd-udev-trigger. Every rule keys on a node name, so on any other
# device running this rootfs none of them match.

ACTION=="add", KERNEL=="hw_random", OWNER="root", GROUP="system", MODE="0440"
ACTION=="add", KERNEL=="diag", OWNER="radio", GROUP="radio", MODE="0660"
ACTION=="add", KERNEL=="diag_arm9", OWNER="radio", GROUP="radio", MODE="0660"
ACTION=="add", KERNEL=="uinput", OWNER="system", GROUP="bluetooth", MODE="0660"
ACTION=="add", KERNEL=="rtc0", OWNER="system", GROUP="system", MODE="0640"
ACTION=="add", KERNEL=="oncrpc/*", OWNER="root", GROUP="system", MODE="0660"
ACTION=="add", KERNEL=="msm_camera/*", OWNER="system", GROUP="system", MODE="0660"
ACTION=="add", KERNEL=="smd0", OWNER="radio", GROUP="radio", MODE="0640"
ACTION=="add", KERNEL=="diag", OWNER="system", GROUP="diag", MODE="0660"
ACTION=="add", KERNEL=="wlan", OWNER="system", GROUP="system", MODE="0666"
ACTION=="add", KERNEL=="rtc0", OWNER="system", GROUP="system", MODE="0660"
ACTION=="add", KERNEL=="smd7", OWNER="bluetooth", GROUP="bluetooth", MODE="0660"
ACTION=="add", KERNEL=="ipa", OWNER="system", GROUP="radio", MODE="0660"
ACTION=="add", KERNEL=="wwan_ioctl", OWNER="system", GROUP="radio", MODE="0660"
ACTION=="add", KERNEL=="ipaNatTable", OWNER="system", GROUP="radio", MODE="0660"
ACTION=="add", KERNEL=="rmnet_ctrl", OWNER="usb", GROUP="usb", MODE="0660"
ACTION=="add", KERNEL=="hw_random", OWNER="root", GROUP="root", MODE="0600"
ACTION=="add", KERNEL=="wcd-spi-ac-client", OWNER="system", GROUP="audio", MODE="0660"
ACTION=="add", KERNEL=="msm_amrnb_in", OWNER="system", GROUP="audio", MODE="0640"
ACTION=="add", KERNEL=="msm_a2dp_in", OWNER="system", GROUP="audio", MODE="0660"
ACTION=="add", KERNEL=="msm_cirrus_playback", OWNER="system", GROUP="audio", MODE="0660"
ACTION=="add", KERNEL=="msm_audio_cal", OWNER="system", GROUP="audio", MODE="0660"
ACTION=="add", KERNEL=="i2c-5", OWNER="media", GROUP="media", MODE="0660"
ACTION=="add", KERNEL=="ramdump_*", OWNER="system", GROUP="system", MODE="0640"
ACTION=="add", KERNEL=="ttyHS0", OWNER="bluetooth", GROUP="net_bt", MODE="0660"
ACTION=="add", KERNEL=="btpower", OWNER="bluetooth", GROUP="net_bt", MODE="0660"
ACTION=="add", KERNEL=="pn81a", OWNER="secure_element", GROUP="secure_element", MODE="0660"
ACTION=="add", KERNEL=="citadel0", OWNER="hsm", GROUP="hsm", MODE="0660"
ACTION=="add", KERNEL=="easelcomm-client", OWNER="cameraserver", GROUP="camera", MODE="0666"
ACTION=="add", KERNEL=="mnh_sm", OWNER="cameraserver", GROUP="camera", MODE="0666"
ACTION=="add", KERNEL=="block/platform/soc/7c4000.sdhci/by-name/frp", OWNER="system", GROUP="system", MODE="0660"
ACTION=="add", KERNEL=="v4l2loopback", GROUP="video", MODE="0660"
