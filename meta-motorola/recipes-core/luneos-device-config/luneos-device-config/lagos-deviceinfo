# Tier 1 adaptation for the Motorola moto g06 (lagos; MT6768, 6.88" 720x1640).
#
# Only what cannot be derived belongs here. Vendor API level, panel geometry
# and the touchscreen node derive on a Treble device. Values are read from the
# stock firmware (VVOB35.78-188) unless marked UNVERIFIED. The phone has booted
# LuneOS twice (tester's live logs of 10 and 11 Nov 2026).

# The power key and the volume rocker, pinned by name, never by node number
# (numbering depends on probe order across ~360 vendor modules). Both strings
# are in the stock modules: mtk-pmic-keys.ko ("mtk-pmic-keys", the PMIC power
# key) and mtk-kpd.ko ("mtk-kpd", the keypad the volume rocker hangs off).
# Both are the input devices' names on hardware (/proc/bus/input/devices,
# 10 and 11 Nov 2026).
deviceinfo_key_devices_by_name="mtk-pmic-keys;mtk-kpd"

# 6.88" diagonal, 720x1640: sqrt(720^2 + 1640^2) / 6.88 = 260 ppi. Android
# ships ro.sf.lcd_density=280. UNVERIFIED ON HARDWARE.
deviceinfo_display_dpi="260"

# 720 / 1.6 = 450 CSS px, the canvas width the webOS apps target (sargo:
# 1080 / 2.4). Expect to re-tune on the device.
deviceinfo_device_pixel_ratio="1.6"

# --- panel shape -----------------------------------------------------------
# A camera hole at the top centre. The stock firmware defines it in two
# Motorola overlays on /product/overlay, as config_mainBuiltInDisplayCutout
# (pixels, x from the panel's centre):
#
#   LagosliteDisplayCutoutOverlay.apk  "M -24,0 L 24,0 L 24,70 L -24,70 Z"
#                                      status_bar_height 40dp
#   LagosDisplayCutoutOverlay.apk      "M -36,0 L 36,0 L 36,102 L -36,102 Z"
#                                      status_bar_height 41dp
#
# Both are non-static, and something on Android picks one at boot. This phone
# runs at ro.sf.lcd_density=280, so 1 dp = 1.75 px. Lagoslite's 40 dp status
# bar is then exactly its 70 px cutout depth, and the product build's own
# framework overlay (framework-res__lagos_sys__auto_generated_rro_product.apk)
# sets 40 dp as well. Lagos's 41 dp is 72 px, short of its own 102 px cutout,
# which only fits a density of about 400. So the lagoslite shape is the one
# for this panel: x 360-24 = 336, 48 wide, 70 deep. UNVERIFIED ON HARDWARE:
# check that the status bar clears the camera.
#
# Motorola's overlays set no rounded-corner radius, so none is declared here.
deviceinfo_display_cutouts="336 0 48 70"

# --- MediaTek vendor userspace --------------------------------------------
# Carried over from the other MediaTek ports (MP01, Q25, radon), where each was
# established. Recorded with what it is for, so a reader can tell whether it
# still applies.

# Qt's hwcomposer QPA backend. ro.hardware.hwcomposer=mtk_common here as on the
# MP01, where the compositor otherwise spun trying to become DRM master. The
# vendor's composer HAL is AIDL composer3, but /vendor/lib64/hw still ships the
# legacy hwcomposer.mt6768.so.
deviceinfo_force_hwc2="1"

# MediaTek's audio HAL (audio.primary.mt6768.so, loaded into pulseaudio by
# module-droid) runs its paths at 48 kHz.
deviceinfo_audio_sample_rate="48000"

# The vendor's audio HAL needs the vendor's libtinyxml2. pulseaudio died with
# SIGSEGV on every start, inside the HAL's constructor, right after
#
#   AudioALSADeviceParser: getCardName(), card name mt6768mt6358
#   AudioALSADeviceParser: card open success
#
# Its core dump (tester's live log, 14 Nov 2026) shows why. getCardName() puts
# a tinyxml2::XMLDocument on the stack, sized for the vendor's tinyxml2 at
# 0x308 bytes, but libhybris resolved libtinyxml2.so from the GSI's /system,
# whose constructor writes out to 0x368. That overwrites getCardName()'s saved
# registers, and ParseCardIndex() then faults storing through "this" = 0xa.
# This key gives pulseaudio alone the vendor's copy; see 70-pulseaudio-env.
#
# hybris_prefer_vndk, set here before, does not help and is gone. Its two
# variables were in pulseaudio's environment in that core and changed nothing:
# HYBRIS_PREFER_VNDK needs a VNDK APEX at or above the vendor's sepolicy
# version (202404) and the GSI's stop at v34, and HYBRIS_USE_VENDOR_NAMESPACE
# only matters with an ld.config.txt, which the host has none of.
# UNVERIFIED ON HARDWARE: the cause is read from the core, the fix not yet run.
deviceinfo_pulseaudio_vendor_libtinyxml2="1"

# The connac1x Bluetooth controller (ro.vendor.bt.platform=connac1x) advertises
# Synchronization Train support in extended features page 2 and then rejects
# the command, as on the MP01, the Q25 and the BraX3. Measured on the second
# LuneOS boot (11 Nov 2026): bluebinder came up on /dev/vhci, then
#
#   Bluetooth: hci0: Opcode 0x0c77 failed: -56
#
# so hci0 never finished setup and the Bluetooth service listed no adapter.
# The same mask clears that bit in what bluebinder reports to the kernel.
deviceinfo_bluebinder_ext_features_page_2_mask="0x0400000000000000"

# VoLTE, SMS over IMS and Wi-Fi calling through the MediaTek extension
# (ofono-binder-plugin-ext-mtk), Wi-Fi preferred. Read from the vendor image,
# not yet run on hardware: the radio is AIDL like the BraX3's
# (IMtkRadioExIms/slot1 and slot2, version 2), but the IMS stack and the ePDG
# tunnel run on the Android side like the Q25's (volte_stack, volte_ua,
# volte_imcb, volte_imsm_93, wfca, epdg_wod, charon; iwlan_operation_mode
# AP-assisted). The tester's 15 Nov 2026 log shows all of them starting. As on
# the Q25 it needs IWLAN in the IMS data profile's bearers (ofono-binder-plugin
# 0037), dummy_netd for epdg_wod's DNS and the firewall letting IPsec traffic
# in; wifi.interface is empty here too, so the extension uses wlan0.
deviceinfo_binder_ext_plugin="mtk:wfcPreference=wifi"
