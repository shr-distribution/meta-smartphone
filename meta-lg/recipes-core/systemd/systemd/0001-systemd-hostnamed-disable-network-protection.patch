From 1dccb96907c7a810ada884c8036f1d17c3c539cc Mon Sep 17 00:00:00 2001
From: Christophe Chapuis <chris.chapuis@gmail.com>
Date: Mon, 5 Apr 2021 13:46:41 +0000
Subject: [PATCH] systemd-hostnamed: disable network protection

Upstream-Status: Inappropriate [kernel version not supported anymore by systemd]

Context refreshed for systemd 257.8: upstream replaced PrivateDevices=yes with
DeviceAllow=/dev/vsock r in this block, so hunk 1 no longer applied. The change
itself is unchanged - comment out PrivateNetwork and RestrictNamespaces.

---
 units/systemd-hostnamed.service.in | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/units/systemd-hostnamed.service.in b/units/systemd-hostnamed.service.in
--- a/units/systemd-hostnamed.service.in
+++ b/units/systemd-hostnamed.service.in
@@ -24,7 +24,7 @@ LockPersonality=yes
 MemoryDenyWriteExecute=yes
 NoNewPrivileges=yes
 DeviceAllow=/dev/vsock r
-PrivateNetwork=yes
+#PrivateNetwork=yes
 PrivateTmp=yes
 ProtectProc=invisible
 ProtectControlGroups=yes
@@ -35,7 +35,7 @@ ProtectKernelTunables=yes
 ProtectSystem=strict
 ReadWritePaths=/etc /run/systemd
 RestrictAddressFamilies=AF_UNIX
-RestrictNamespaces=yes
+#RestrictNamespaces=yes
 RestrictRealtime=yes
 RestrictSUIDSGID=yes
 SystemCallArchitectures=native
