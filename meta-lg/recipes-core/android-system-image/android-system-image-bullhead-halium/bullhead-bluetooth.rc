# The vendor declares the Bluetooth HAL passthrough only and ships no service (LineageOS loaded
# the HAL inside its Bluetooth app). bluebinder wants IBluetoothHci on hwbinder and a running
# init.svc.*bluetooth*. This is the AOSP default service (32-bit; the vendor has the 32-bit impl
# and libbt-vendor), with the a3lte rc plus net_bt, the group init.bullhead.rc gives ttyHS0 and
# rfkill.
service vendor.bluetooth-1-0 /odm/bin/hw/android.hardware.bluetooth@1.0-service
    interface android.hardware.bluetooth@1.0::IBluetoothHci default
    class hal
    capabilities BLOCK_SUSPEND NET_ADMIN SYS_NICE
    user bluetooth
    group bluetooth net_bt
    task_profiles HighPerformance

# wcnss_filter is "disabled" and meant to run only when libbt-vendor asks for it
# (wc_transport.start_hci=true, the vendor's triggers in init.bullhead.rc stay). Here libbt-vendor
# opens /dev/ttyHS0 itself, but start-android-hals.sh force-starts every disabled late_start
# service, so the filter read the same UART and ate the controller's answer (round 10:
# "WCNSS_FILTER: handle_soc_events: Unexpected data format", bt_vendor waiting for the vendor
# event forever, initialize failing). A class that script does not start keeps it off.
service start_hci_filter /vendor/bin/wcnss_filter
    override
    class luneos_off
    user bluetooth
    group bluetooth system
    disabled
