# The shims LineageOS 21's linker loaded for these vendor blobs (TARGET_LD_SHIM_LIBS, read from
# its linker64); the GSI's linker has no such list, so they failed to link and restarted every
# 5 s: ATFWD-daemon and libcne.so want strdup8to16 (libshim_dpmframework.so, in the vendor),
# libril-qc-qmi-1.so wants AudioSystem::setErrorCallback (libaudioclient_shim.so, from LineageOS
# 21's /system/lib64). A preloaded library is in the global group, so rild's dlopen of the RIL
# finds the symbol. The bodies are the vendor's own (rild.rc, init.bullhead.rc).
service vendor.ril-daemon /vendor/bin/hw/rild
    override
    class main
    user radio
    group radio cache inet misc audio log readproc wakelock
    capabilities BLOCK_SUSPEND NET_ADMIN NET_RAW
    setenv LD_PRELOAD /odm/lib64/libaudioclient_shim.so
    # The shim pulls in the vendor's libaudioclient and libmediautils, which want
    # checkCallingPermission and PermissionCache from the system build of libbinder
    # (round 9: "cannot locate symbol _ZN7android22checkCallingPermission..."); the
    # vendor's own libbinder has neither. LineageOS 21's 64-bit one, for rild only.
    setenv LD_LIBRARY_PATH /odm/lib64/bullhead-rild

service atfwd /vendor/bin/ATFWD-daemon
    override
    class late_start
    user system
    group system radio
    setenv LD_PRELOAD /vendor/lib64/libshim_dpmframework.so

# The vendor's cnd has no user, which this init rejects; it ran as root on LineageOS.
service cnd /vendor/bin/cnd
    override
    class late_start
    socket cnd stream 660 root inet
    user root
    group root wakelock
    disabled
    setenv LD_PRELOAD /vendor/lib64/libshim_dpmframework.so

# lmkd aborts in a static constructor of libmemevents (BPF memory events; a 3.10 kernel has no
# BPF) before main, every time, and init restarted it every 5 s (306 tombstones in round 8).
# LuneOS runs no Android framework for it to serve. An override from /odm is refused for a
# system service ("overrides another service across the treble boundary", round 9), so stop it
# instead whenever init schedules its restart; a stopped service is not restarted.
on property:init.svc.lmkd=restarting
    stop lmkd
