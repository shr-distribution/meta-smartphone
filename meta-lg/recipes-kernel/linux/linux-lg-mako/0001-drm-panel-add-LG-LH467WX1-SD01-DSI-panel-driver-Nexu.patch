From: Herman van Hazendonk <github.com@herrie.org>
Subject: [PATCH] drm/panel: add LG LH467WX1-SD01 DSI panel driver (Nexus 4)

Add a driver for the LG LH467WX1-SD01 768x1280 DSI video mode panel used in
the Google Nexus 4 (mako).

Based on the WIP driver by Ivan Belokobylskiy <belokobylskij@gmail.com>
(apq8064-mainline/linux, commit 3f0c30f5), reworked for current DRM and
corrected against the downstream mako kernel (mipi_lgit.c and
board-mako-display.c):

 - the vendor registers (0xB0 and up) are generic long writes, not DCS
 - the 0xC2 power control byte is 0x06; the WIP had 0x063
 - the IEF registers are sent in downstream order
 - the external DSV boost (TLMM GPIO 57) is enabled between power_on_set_2
   and power_on_set_3, as downstream does; the WIP had no DSV handling and
   the picture does not appear without it
 - VCI is set to 3.0 V, as downstream does

The panel timings in the WIP already matched downstream and are unchanged.
Not tested on hardware.

Signed-off-by: Herman van Hazendonk <github.com@herrie.org>
Upstream-Status: Pending

diff --git a/drivers/gpu/drm/panel/Kconfig b/drivers/gpu/drm/panel/Kconfig
index d592f4f4b939..6633f9c6d750 100644
--- a/drivers/gpu/drm/panel/Kconfig
+++ b/drivers/gpu/drm/panel/Kconfig
@@ -450,6 +450,15 @@ config DRM_PANEL_LG_LD070WX3
 	  To compile this driver as a module, choose M here: the module will
 	  be called panel-lg-ld070wx3.
 
+config DRM_PANEL_LG_LH467WX1_SD01
+	tristate "LG LH467WX1-SD01 DSI panel"
+	depends on OF
+	depends on DRM_MIPI_DSI
+	depends on BACKLIGHT_CLASS_DEVICE
+	help
+	  Say Y here if you want to enable support for the LG LH467WX1-SD01
+	  768x1280 DSI video mode panel found in the Google Nexus 4 (mako).
+
 config DRM_PANEL_LG_LG4573
 	tristate "LG4573 RGB/SPI panel"
 	depends on OF && SPI
diff --git a/drivers/gpu/drm/panel/Makefile b/drivers/gpu/drm/panel/Makefile
index a4291dc3905b..6e6d9948441e 100644
--- a/drivers/gpu/drm/panel/Makefile
+++ b/drivers/gpu/drm/panel/Makefile
@@ -46,6 +46,7 @@ obj-$(CONFIG_DRM_PANEL_LINCOLNTECH_LCD197) += panel-lincolntech-lcd197.o
 obj-$(CONFIG_DRM_PANEL_LG_LB035Q02) += panel-lg-lb035q02.o
 obj-$(CONFIG_DRM_PANEL_LG_LD070WX3) += panel-lg-ld070wx3.o
 obj-$(CONFIG_DRM_PANEL_LG_LG4573) += panel-lg-lg4573.o
+obj-$(CONFIG_DRM_PANEL_LG_LH467WX1_SD01) += panel-lg-lh467wx1-sd01.o
 obj-$(CONFIG_DRM_PANEL_LG_SW43408) += panel-lg-sw43408.o
 obj-$(CONFIG_DRM_PANEL_LXD_M9189A) += panel-lxd-m9189a.o
 obj-$(CONFIG_DRM_PANEL_MAGNACHIP_D53E6EA8966) += panel-magnachip-d53e6ea8966.o
diff --git a/drivers/gpu/drm/panel/panel-lg-lh467wx1-sd01.c b/drivers/gpu/drm/panel/panel-lg-lh467wx1-sd01.c
new file mode 100644
index 000000000000..b282f1b5b05e
--- /dev/null
+++ b/drivers/gpu/drm/panel/panel-lg-lh467wx1-sd01.c
@@ -0,0 +1,299 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * LG LH467WX1-SD01 768x1280 MIPI DSI video mode panel (Google Nexus 4 / mako)
+ *
+ * Copyright (C) 2021 Ivan Belokobylskiy <belokobylskij@gmail.com>
+ *
+ * Reworked for current DRM, with the command sequence, ordering and the
+ * external DSV supply taken from the downstream mako kernel (mipi_lgit.c and
+ * board-mako-display.c) rather than from the original WIP port.
+ */
+
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/mod_devicetable.h>
+#include <linux/module.h>
+#include <linux/regulator/consumer.h>
+
+#include <drm/drm_mipi_dsi.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_panel.h>
+#include <drm/drm_probe_helper.h>
+
+struct lh467wx1_sd01 {
+	struct drm_panel panel;
+	struct mipi_dsi_device *dsi;
+	struct regulator_bulk_data supplies[2];
+	struct gpio_desc *reset_gpio;
+	struct gpio_desc *dsv_gpio;
+};
+
+static inline struct lh467wx1_sd01 *to_lh467wx1_sd01(struct drm_panel *panel)
+{
+	return container_of(panel, struct lh467wx1_sd01, panel);
+}
+
+/*
+ * The vendor registers (0xB0 and up) are sent as generic long writes, exactly
+ * as downstream does with DTYPE_GEN_LWRITE; only 0x29/0x28/0x10 are DCS.
+ */
+#define lh467_gen(ctx, seq...)						\
+	mipi_dsi_generic_write_seq_multi(ctx, seq)
+
+static void lh467wx1_sd01_reset(struct lh467wx1_sd01 *ctx)
+{
+	/* Held in reset (low) until the supplies are up, then released. */
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	usleep_range(2000, 3000);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	usleep_range(5000, 6000);
+}
+
+static int lh467wx1_sd01_on(struct lh467wx1_sd01 *ctx)
+{
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	ctx->dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+
+	/* power_on_set_1: display initial set */
+	lh467_gen(&dsi_ctx, 0x36, 0x02);
+	lh467_gen(&dsi_ctx, 0xb0, 0x43, 0x00, 0x00, 0x00, 0x00);
+	lh467_gen(&dsi_ctx, 0xb3, 0x0a, 0x9f);
+	lh467_gen(&dsi_ctx, 0xb5, 0x50, 0x20, 0x40, 0x00, 0x20);
+	lh467_gen(&dsi_ctx, 0xb6, 0x00, 0x14, 0x0f, 0x16, 0x13, 0x05, 0x05);
+
+	/* gamma */
+	lh467_gen(&dsi_ctx, 0xd0, 0x40, 0x44, 0x76, 0x01, 0x00, 0x00, 0x30, 0x20, 0x01);
+	lh467_gen(&dsi_ctx, 0xd1, 0x40, 0x44, 0x76, 0x01, 0x00, 0x00, 0x30, 0x20, 0x01);
+	lh467_gen(&dsi_ctx, 0xd2, 0x40, 0x44, 0x76, 0x01, 0x00, 0x00, 0x30, 0x20, 0x01);
+	lh467_gen(&dsi_ctx, 0xd3, 0x40, 0x44, 0x76, 0x01, 0x00, 0x00, 0x30, 0x20, 0x01);
+	lh467_gen(&dsi_ctx, 0xd4, 0x20, 0x23, 0x74, 0x00, 0x1f, 0x10, 0x50, 0x33, 0x03);
+	lh467_gen(&dsi_ctx, 0xd5, 0x20, 0x23, 0x74, 0x00, 0x1f, 0x10, 0x50, 0x33, 0x03);
+
+	/* image enhancement (IEF); downstream order, 0xE4-E6 come after E1-E3 */
+	lh467_gen(&dsi_ctx, 0xe0, 0x00);
+	lh467_gen(&dsi_ctx, 0xe1, 0x00, 0x00, 0x01, 0x01);
+	lh467_gen(&dsi_ctx, 0xe2, 0x01, 0x00);
+	lh467_gen(&dsi_ctx, 0xe3, 0x00, 0x00, 0x42, 0x35, 0x00);
+	lh467_gen(&dsi_ctx, 0xe4, 0x00, 0x00, 0x00);
+	lh467_gen(&dsi_ctx, 0xe5, 0x00, 0x00, 0x00);
+	lh467_gen(&dsi_ctx, 0xe6, 0x00, 0x00, 0x00);
+	lh467_gen(&dsi_ctx, 0xe7, 0x40, 0x40, 0x40, 0x40, 0x40, 0x40, 0x40, 0x40);
+	lh467_gen(&dsi_ctx, 0xe8, 0x3d, 0x3d, 0x3d, 0x3d, 0x3d, 0x3d, 0x3d, 0x3d);
+	lh467_gen(&dsi_ctx, 0xe9, 0x3b, 0x3b, 0x3b, 0x3b, 0x3b, 0x3b, 0x3b, 0x3b);
+	lh467_gen(&dsi_ctx, 0xea, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00);
+	lh467_gen(&dsi_ctx, 0xeb, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00);
+	lh467_gen(&dsi_ctx, 0xec, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00);
+
+	/* power supply */
+	lh467_gen(&dsi_ctx, 0xc0, 0x00, 0x0a, 0x10);
+	lh467_gen(&dsi_ctx, 0xc3, 0x00, 0x88, 0x03, 0x20, 0x01, 0x57, 0x4f, 0x33,
+		  0x02, 0x38, 0x38, 0x00);
+	lh467_gen(&dsi_ctx, 0xc4, 0x31, 0x24, 0x11, 0x11, 0x3d);
+	lh467_gen(&dsi_ctx, 0xc5, 0x3b, 0x3b, 0x03);
+
+	/* power_on_set_2 */
+	lh467_gen(&dsi_ctx, 0xc2, 0x06);
+	mipi_dsi_msleep(&dsi_ctx, 10);
+	lh467_gen(&dsi_ctx, 0xc2, 0x0e);
+	mipi_dsi_msleep(&dsi_ctx, 1);
+
+	/*
+	 * The panel's +/-5.5 V rails come from an external boost enabled between
+	 * power_on_set_2 and _3; the picture never appears without it.
+	 */
+	if (dsi_ctx.accum_err)
+		return dsi_ctx.accum_err;
+	gpiod_set_value_cansleep(ctx->dsv_gpio, 1);
+	msleep(20);
+
+	/* power_on_set_3 */
+	lh467_gen(&dsi_ctx, 0xf1, 0x10, 0x00);
+	lh467_gen(&dsi_ctx, 0x11, 0x00);
+	lh467_gen(&dsi_ctx, 0xc1, 0x08);
+	mipi_dsi_dcs_set_display_on_multi(&dsi_ctx);
+
+	return dsi_ctx.accum_err;
+}
+
+static int lh467wx1_sd01_off(struct lh467wx1_sd01 *ctx)
+{
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	ctx->dsi->mode_flags &= ~MIPI_DSI_MODE_LPM;
+
+	/* power_off_set_1 */
+	mipi_dsi_dcs_set_display_off_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 20);
+	mipi_dsi_dcs_enter_sleep_mode_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 5);
+
+	/* the DSV boost goes down before the panel's own power-off set */
+	gpiod_set_value_cansleep(ctx->dsv_gpio, 0);
+	msleep(20);
+
+	/* power_off_set_2 */
+	lh467_gen(&dsi_ctx, 0xc2, 0x00);
+	mipi_dsi_msleep(&dsi_ctx, 10);
+	lh467_gen(&dsi_ctx, 0xc2, 0x01);
+	mipi_dsi_msleep(&dsi_ctx, 10);
+	lh467_gen(&dsi_ctx, 0xc2, 0x00);
+	lh467_gen(&dsi_ctx, 0xc1, 0x02);
+	mipi_dsi_msleep(&dsi_ctx, 10);
+
+	return dsi_ctx.accum_err;
+}
+
+static int lh467wx1_sd01_prepare(struct drm_panel *panel)
+{
+	struct lh467wx1_sd01 *ctx = to_lh467wx1_sd01(panel);
+	struct device *dev = &ctx->dsi->dev;
+	int ret;
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(ctx->supplies), ctx->supplies);
+	if (ret < 0) {
+		dev_err(dev, "Failed to enable regulators: %d\n", ret);
+		return ret;
+	}
+
+	lh467wx1_sd01_reset(ctx);
+
+	ret = lh467wx1_sd01_on(ctx);
+	if (ret < 0) {
+		dev_err(dev, "Failed to initialize panel: %d\n", ret);
+		gpiod_set_value_cansleep(ctx->dsv_gpio, 0);
+		gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+		regulator_bulk_disable(ARRAY_SIZE(ctx->supplies), ctx->supplies);
+		return ret;
+	}
+
+	return 0;
+}
+
+static int lh467wx1_sd01_unprepare(struct drm_panel *panel)
+{
+	struct lh467wx1_sd01 *ctx = to_lh467wx1_sd01(panel);
+	struct device *dev = &ctx->dsi->dev;
+	int ret;
+
+	ret = lh467wx1_sd01_off(ctx);
+	if (ret < 0)
+		dev_err(dev, "Failed to un-initialize panel: %d\n", ret);
+
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	regulator_bulk_disable(ARRAY_SIZE(ctx->supplies), ctx->supplies);
+
+	return 0;
+}
+
+/* 453.77 MHz DSI link / 4 lanes / RGB888 gives ~60 Hz; timings from downstream */
+static const struct drm_display_mode lh467wx1_sd01_mode = {
+	.clock = (768 + 8 + 4 + 180) * (1280 + 8 + 2 + 22) * 60 / 1000,
+	.hdisplay = 768,
+	.hsync_start = 768 + 8,
+	.hsync_end = 768 + 8 + 4,
+	.htotal = 768 + 8 + 4 + 180,
+	.vdisplay = 1280,
+	.vsync_start = 1280 + 8,
+	.vsync_end = 1280 + 8 + 2,
+	.vtotal = 1280 + 8 + 2 + 22,
+	.width_mm = 61,
+	.height_mm = 102,
+};
+
+static int lh467wx1_sd01_get_modes(struct drm_panel *panel,
+				   struct drm_connector *connector)
+{
+	return drm_connector_helper_get_modes_fixed(connector, &lh467wx1_sd01_mode);
+}
+
+static const struct drm_panel_funcs lh467wx1_sd01_panel_funcs = {
+	.prepare = lh467wx1_sd01_prepare,
+	.unprepare = lh467wx1_sd01_unprepare,
+	.get_modes = lh467wx1_sd01_get_modes,
+};
+
+static int lh467wx1_sd01_probe(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	struct lh467wx1_sd01 *ctx;
+	int ret;
+
+	ctx = devm_drm_panel_alloc(dev, struct lh467wx1_sd01, panel,
+				   &lh467wx1_sd01_panel_funcs,
+				   DRM_MODE_CONNECTOR_DSI);
+	if (IS_ERR(ctx))
+		return PTR_ERR(ctx);
+
+	ctx->supplies[0].supply = "vci";
+	ctx->supplies[1].supply = "iovcc";
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(ctx->supplies),
+				      ctx->supplies);
+	if (ret < 0)
+		return dev_err_probe(dev, ret, "Failed to get regulators\n");
+
+	/* VCI is a 2.8-3.0 V rail shared with other consumers; downstream runs it at 3.0 V */
+	ret = regulator_set_voltage(ctx->supplies[0].consumer, 3000000, 3000000);
+	if (ret < 0)
+		return dev_err_probe(dev, ret, "Failed to set VCI voltage\n");
+
+	ctx->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(ctx->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->reset_gpio),
+				     "Failed to get reset-gpios\n");
+
+	ctx->dsv_gpio = devm_gpiod_get(dev, "dsv", GPIOD_OUT_LOW);
+	if (IS_ERR(ctx->dsv_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->dsv_gpio),
+				     "Failed to get dsv-gpios\n");
+
+	ctx->dsi = dsi;
+	mipi_dsi_set_drvdata(dsi, ctx);
+
+	dsi->lanes = 4;
+	dsi->format = MIPI_DSI_FMT_RGB888;
+	/* downstream: non-burst, sync events (no pulses), so plain VIDEO mode */
+	dsi->mode_flags = MIPI_DSI_MODE_VIDEO;
+
+	ret = drm_panel_of_backlight(&ctx->panel);
+	if (ret)
+		return dev_err_probe(dev, ret, "Failed to get backlight\n");
+
+	drm_panel_add(&ctx->panel);
+
+	ret = mipi_dsi_attach(dsi);
+	if (ret < 0) {
+		drm_panel_remove(&ctx->panel);
+		return dev_err_probe(dev, ret, "Failed to attach to DSI host\n");
+	}
+
+	return 0;
+}
+
+static void lh467wx1_sd01_remove(struct mipi_dsi_device *dsi)
+{
+	struct lh467wx1_sd01 *ctx = mipi_dsi_get_drvdata(dsi);
+
+	mipi_dsi_detach(dsi);
+	drm_panel_remove(&ctx->panel);
+}
+
+static const struct of_device_id lh467wx1_sd01_of_match[] = {
+	{ .compatible = "lg,lh467wx1-sd01" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, lh467wx1_sd01_of_match);
+
+static struct mipi_dsi_driver lh467wx1_sd01_driver = {
+	.probe = lh467wx1_sd01_probe,
+	.remove = lh467wx1_sd01_remove,
+	.driver = {
+		.name = "panel-lg-lh467wx1-sd01",
+		.of_match_table = lh467wx1_sd01_of_match,
+	},
+};
+module_mipi_dsi_driver(lh467wx1_sd01_driver);
+
+MODULE_AUTHOR("Ivan Belokobylskiy <belokobylskij@gmail.com>");
+MODULE_DESCRIPTION("LG LH467WX1-SD01 MIPI DSI panel driver (Nexus 4)");
+MODULE_LICENSE("GPL");
