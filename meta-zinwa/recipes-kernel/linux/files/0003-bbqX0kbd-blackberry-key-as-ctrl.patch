diff --git a/drivers/input/keyboard/bbqX0kbd/bbq20kbd_pmod_codes.h b/drivers/input/keyboard/bbqX0kbd/bbq20kbd_pmod_codes.h
--- a/drivers/input/keyboard/bbqX0kbd/bbq20kbd_pmod_codes.h
+++ b/drivers/input/keyboard/bbqX0kbd/bbq20kbd_pmod_codes.h
@@ -68,7 +68,7 @@
 #endif
 
 	[0x06] = KEY_SEND,
-	[0x11] = 580,
+	[0x11] = KEY_LEFTCTRL,
 	[0x07] = KEY_BACK,
