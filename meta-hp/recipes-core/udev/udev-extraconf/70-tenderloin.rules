# modalias for touch screen doesn't match the common rule so we add it statically here

# Only what this machine does not share with the others: nodes unique to it, and
# the handful where its owner/group/mode differs from the common set now folded
# into 65-android.rules. udev reads this file after that one, so these still win.
SUBSYSTEM=="input", KERNEL=="event[0-9]*", ATTRS{modalias}=="input:b0006v0001p0001e0001-e0,3,kra30,35,36,39,3A,mlsfw", TAG+="systemd", SYMLINK+="input/touchscreen0"
ACTION=="add", KERNEL=="rtc0", OWNER="system", GROUP="system", MODE="0600"
ACTION=="add", KERNEL=="btdiag", OWNER="radio", GROUP="radio", MODE="0660"
ACTION=="add", KERNEL=="diag_mdm", OWNER="radio", GROUP="radio", MODE="0660"
ACTION=="add", KERNEL=="htcdiag", OWNER="radio", GROUP="radio", MODE="0660"
ACTION=="add", KERNEL=="genlock", OWNER="root", GROUP="root", MODE="0666"
ACTION=="add", KERNEL=="kgsl-3d0", OWNER="root", GROUP="root", MODE="0666"
ACTION=="add", KERNEL=="msm_camera/*", OWNER="system", GROUP="audio", MODE="0660"
ACTION=="add", KERNEL=="ttyHS0", OWNER="bluetooth", GROUP="bluetooth", MODE="0660"
ACTION=="add", KERNEL=="msm_rotator", OWNER="system", GROUP="system", MODE="0660"
ACTION=="add", KERNEL=="pmem_audio", OWNER="system", GROUP="audio", MODE="0660"
ACTION=="add", KERNEL=="pmem_smipool*", OWNER="system", GROUP="camera", MODE="0660"
