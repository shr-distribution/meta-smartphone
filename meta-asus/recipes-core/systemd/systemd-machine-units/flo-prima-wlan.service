[Unit]
Description=Start the built-in prima WLAN driver
After=android-system.service
Before=network.target connman.service
Conflicts=shutdown.target actdead.target

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=150
# The container's wcnss_init (init.flox.wifi.sh: conn_init, then a write to /dev/wcnss_wlan) has the
# WCNSS driver boot the Riva core and download the NV data. The WLAN host driver, prima, is built into
# this kernel (CONFIG_PRIMA_WLAN=y) and only starts when "sta" is written to its fwpath parameter, which
# on Android the Wi-Fi HAL does when Wi-Fi is switched on; that HAL is not started here
# (deviceinfo_android_skip_services). Same as a3-prima-wlan.service on the Galaxy A3 (2015).
#
# The driver can only attach once the WCNSS control channel is up; until then wcnss_version reads
# INVALID. The board-file kernel has no device tree, so the attribute is looked up rather than named.
ExecStart=/bin/sh -c 'n=0; v=; while [ $n -lt 90 ]; do v=$(ls /sys/devices/platform/wcnss_wlan*/wcnss_version 2>/dev/null | head -n 1); [ -n "$v" ] && [ "$(cat $v)" != INVALID ] && break; sleep 1; n=$((n+1)); done; [ -n "$v" ] && [ "$(cat $v)" != INVALID ] || { echo "WCNSS control channel never came up"; exit 1; }; echo sta > /sys/module/wlan/parameters/fwpath; n=0; while [ ! -e /sys/class/net/wlan0 ] && [ $n -lt 20 ]; do sleep 1; n=$((n+1)); done; [ -e /sys/class/net/wlan0 ]'

[Install]
WantedBy=basic.target
