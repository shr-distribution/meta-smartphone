

# Only what this machine does not share with the others: nodes unique to it, and
# the handful where its owner/group/mode differs from the common set now folded
# into 65-android.rules. udev reads this file after that one, so these still win.
ACTION=="add", KERNEL=="diag", OWNER="system", GROUP="qcom_diag", MODE="0660"
ACTION=="add", KERNEL=="genlock", OWNER="system", GROUP="system", MODE="0666"
ACTION=="add", KERNEL=="kgsl", OWNER="system", GROUP="system", MODE="0666"
ACTION=="add", KERNEL=="kgsl-3d0", OWNER="system", GROUP="system", MODE="0666"
ACTION=="add", KERNEL=="rtc0", OWNER="system", GROUP="system", MODE="0600"
ACTION=="add", KERNEL=="smd0", OWNER="system", GROUP="system", MODE="0660"
ACTION=="add", KERNEL=="smd7", OWNER="bluetooth", GROUP="bluetooth", MODE="0660"
ACTION=="add", KERNEL=="radio0", OWNER="system", GROUP="system", MODE="0640"
ACTION=="add", KERNEL=="system_health_monitor", OWNER="radio", GROUP="system", MODE="0644"
ACTION=="add", KERNEL=="msm_camera/*", OWNER="system", GROUP="camera", MODE="0660"
ACTION=="add", KERNEL=="msm_vidc_reg", OWNER="system", GROUP="audio", MODE="0660"
ACTION=="add", KERNEL=="msm_vidc_dec", OWNER="system", GROUP="audio", MODE="0660"
ACTION=="add", KERNEL=="msm_vidc_dec_sec", OWNER="system", GROUP="audio", MODE="0660"
ACTION=="add", KERNEL=="msm_vidc_enc", OWNER="system", GROUP="audio", MODE="0660"
ACTION=="add", KERNEL=="msm_rotator", OWNER="system", GROUP="system", MODE="0660"
ACTION=="add", KERNEL=="hw_random", OWNER="root", GROUP="root", MODE="0600"
ACTION=="add", KERNEL=="msm_amrnb_in", OWNER="system", GROUP="audio", MODE="0640"
ACTION=="add", KERNEL=="msm_a2dp_in", OWNER="system", GROUP="audio", MODE="0660"
ACTION=="add", KERNEL=="radio0", OWNER="fm_radio", GROUP="fm_radio", MODE="0640"
ACTION=="add", KERNEL=="smd3", OWNER="bluetooth", GROUP="net_bt_stack", MODE="0660"
ACTION=="add", KERNEL=="smd2", OWNER="bluetooth", GROUP="net_bt_stack", MODE="0660"
ACTION=="add", KERNEL=="mdm", OWNER="system", GROUP="radio", MODE="0660"
ACTION=="add", KERNEL=="i2c-5", OWNER="media", GROUP="media", MODE="0660"

# The volume rocker and power key arrive on mtk-kpd, and the headset button on
# ACCDET. udev tags both ID_INPUT_KEY only; the compositor is launched with a
# bare "-plugin evdevkeyboard", which discovers devices through
# ID_INPUT_KEYBOARD, so without these no hardware key reaches the shell.
# Was a device-only /etc/udev/rules.d/71-mindphone-keypad.rules until a userdata
# reflash deleted it (1 Oct 2026).
ACTION=="add|change", SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="mtk-kpd", ENV{ID_INPUT_KEYBOARD}="1"
ACTION=="add|change", SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="ACCDET", ENV{ID_INPUT_KEYBOARD}="1"

# WAM runs as wam (group compositor), not in group system, so the generic
# 65-android.rules ion mode of 0664 leaves it read-only. The vendor ueventd.rc
# grants 0666. Was device-only 72-mindphone-gpu.rules, lost the same way.
ACTION=="add", KERNEL=="ion", OWNER="system", GROUP="system", MODE="0666"
